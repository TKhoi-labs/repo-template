{% raw %}---
# Conventional Commits are enforced here, not in a git hook: hooks are
# bypassable with --no-verify, so enforcement lives in CI.
name: commitlint

on:
  pull_request:

permissions:
  contents: read
  pull-requests: read

jobs:
  commitlint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Lint the pull request's commit messages
        run: |
          npx --yes @commitlint/cli \
            --from "${{ github.event.pull_request.base.sha }}" \
            --to "${{ github.event.pull_request.head.sha }}" \
            --verbose
{% endraw -%}
