{% raw %}---
# Conventional Commits are enforced here, not in a git hook: hooks are
# bypassable with --no-verify, so enforcement lives in CI.
name: commitlint

on:
  pull_request:

# One run per pull request; a new push supersedes the previous run.
concurrency:
  group: commitlint-${{ github.event.pull_request.number }}
  cancel-in-progress: true

permissions:
  contents: read # resolve the commit range from the repository
  pull-requests: read # read the pull request's base and head commits

jobs:
  commitlint:
    name: Lint commit messages
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0 # commitlint needs the history to resolve the range
          persist-credentials: false

      - name: Lint the pull request's commit messages
        # Passed through the environment rather than interpolated into the
        # script: ${{ }} inside `run:` is expanded before the shell sees it.
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          npx --yes @commitlint/cli \
            --from "$BASE_SHA" \
            --to "$HEAD_SHA" \
            --verbose
{% endraw -%}
