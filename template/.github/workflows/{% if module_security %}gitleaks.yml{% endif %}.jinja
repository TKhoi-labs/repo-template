{% raw %}---
# Secret scanning. GitHub push protection is the first line of defence; this
# catches secrets that reached history by another route.
name: gitleaks

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: gitleaks-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read # scan the checked-out history

jobs:
  gitleaks:
    name: Scan for secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0 # scan the whole history, not just the tip
          persist-credentials: false

      - uses: gitleaks/gitleaks-action@ff98106e4c7b2bc287b24eaf42907196329070c7 # v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Required for organisation-owned repositories, which is why this is
          # easy to miss: a personal account needs no key. The key is free but
          # must be requested from gitleaks.io, and it is validated against a
          # third-party service. Without it the job fails with
          # "[org] is an organization. License key is required."
          GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}
{% endraw -%}
