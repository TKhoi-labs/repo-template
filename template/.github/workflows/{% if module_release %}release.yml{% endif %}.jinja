{% raw %}---
name: release

on:
  push:
    tags: ["v*"]

# Never cancel a release half-way through.
concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

permissions: {} # the job below declares exactly what it needs

jobs:
  release:
    name: Publish release notes
    runs-on: ubuntu-latest
    permissions:
      contents: write # create the GitHub release
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0 # git-cliff reads the whole tag history
          persist-credentials: false

      # pipx rather than a third-party action: one less pin to maintain.
      - name: Install git-cliff
        run: pipx install git-cliff

      - name: Generate release notes
        run: git-cliff --current --output RELEASE_NOTES.md

      - name: Publish the release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          TAG: ${{ github.ref_name }}
        run: gh release create "$TAG" --notes-file RELEASE_NOTES.md
{% endraw -%}
