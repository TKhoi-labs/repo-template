# Settings as code, applied by the Settings app:
# https://probot.github.io/apps/settings/
#
# Install the app once per organisation; it then reads this file in every
# repository. Because these settings are a file, a template sync PR also
# propagates label and branch-protection changes across the fleet.
#
# Verified 2026-10-03: the app applies `repository:` and `labels:` but NOT
# `branches:`, and nothing reports that. This block is correct — the app's own
# documentation describes this syntax, and the request succeeds when replayed by
# hand — so keep it, and apply protection yourself until the app is fixed. The
# same applies to installing the app at all: it has no installation handler, so
# it does nothing to existing repositories until something pushes this file.
---
repository:
  name: {{ project_slug }}
  description: {{ description | tojson }}
  has_issues: true
  has_projects: false
  has_wiki: false
  allow_squash_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  delete_branch_on_merge: true
{%- if module_contributing %}
  # contributing: no merge without review
  allow_auto_merge: false
{%- endif %}

branches:
  - name: main
    protection:
      required_pull_request_reviews:
        required_approving_review_count: {% if module_contributing %}2{% else %}0{% endif %}
        dismiss_stale_reviews: true
{%- if module_ci %}
      # The name is "<workflow> / <job>" from the shared reusable workflow, which
      # uses `ci` for both. If the organisation renames it there, this check never
      # reports and every pull request waits forever — adjust it to match.
      required_status_checks:
        strict: false
        contexts:
          - ci / ci
{%- else %}
      # No ci module, so nothing produces a check to require.
      required_status_checks: null
{%- endif %}
      enforce_admins: false
      restrictions: null

labels:
  - name: bug
    color: d73a4a
    description: Something is not working
  - name: task
    color: 0e8a16
    description: Work that is neither a bug nor a feature
  - name: feature
    color: a2eeef
    description: New capability
  - name: dependency
    color: 0366d6
    description: Dependency update
  - name: security
    color: b60205
    description: Security-relevant change
  - name: template-sync
    color: c5def5
    description: Automated sync with the repository template
  # Conventional Comments vocabulary, so review severity is machine-visible.
  - name: "issue: blocking"
    color: b60205
    description: "Conventional Comments: blocking issue"
  - name: nitpick
    color: fef2c0
    description: "Conventional Comments: non-blocking nitpick"
  - name: praise
    color: 5319e7
    description: "Conventional Comments: praise"
